#!/usr/bin/env bash
# hostshell fetcher: materialize a FULLY STATIC userland (real bash + jq, plus a
# busybox supplying the coreutils/sed/grep/tar applets) into $JOBS_OUTPUT_DIR.
#
# The binaries are statically linked (no PT_INTERP, no /nix/store deps), so the
# build/dev sandbox needs NO /nix bind mount — the shell artifact is fully
# relocatable and hermetic (build.md §8, §14). The userland is built reproducibly
# from the repo flake's `shell` package (../../flake.nix), so this fetcher must
# run inside `nix` (the repo dev shell provides it).
set -euo pipefail
out="${JOBS_OUTPUT_DIR:?JOBS_OUTPUT_DIR not set}"

# Resolve the repo flake from this script's location (CWD-independent: the gated
# runner tests invoke this script by absolute path from another directory).
flake="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

shellpkg="$(nix build "$flake#shell" --no-link --print-out-paths)"
mkdir -p "$out/bin"
# -d preserves the busybox applet symlinks; no -p so we don't try to chown.
cp -dr "$shellpkg"/bin/. "$out/bin/"
chmod -R u+rwX "$out/bin"

# Sanity: bash + jq must be static (the whole point — fail loudly otherwise).
for b in bash jq busybox; do
	[ -x "$out/bin/$b" ] || { echo "hostshell: missing $out/bin/$b" >&2; exit 1; }
	info="$(ldd "$out/bin/$b" 2>&1 || true)"
	case "$info" in
		*"not a dynamic executable"*) : ;; # statically linked — good
		*) echo "hostshell: $b is not statically linked:" >&2; echo "$info" >&2; exit 1 ;;
	esac
done
# /bin/sh resolves to busybox (an applet symlink created by the shell package).
[ -e "$out/bin/sh" ] || ln -s busybox "$out/bin/sh"
